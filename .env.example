# ─── Commodity Prices API ────────────────────────────────────────────────────
# Sign up free at https://commodities-api.com (100 req/month on free tier)
COMMODITIES_API_KEY=your_commodities_api_key_here

# ─── Exchange Rate API ────────────────────────────────────────────────────────
# Sign up free at https://exchangerate-api.com (1,500 req/month on free tier)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ─── Optional: Email Delivery (nodemailer) ────────────────────────────────────
# Leave blank to disable email; use Gmail App Password (not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Pakistan Trade Agent <your_email@gmail.com>
# Comma-separated list of report recipients
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ─── Agent Settings ───────────────────────────────────────────────────────────
# Directory to save generated reports (relative to project root)
REPORT_DIR=./reports

# Estimated sea freight cost in USD per kg (Pakistan → major ports)
SHIPPING_COST_PER_KG=0.08

# Log level: debug | info | warn | error
LOG_LEVEL=info
